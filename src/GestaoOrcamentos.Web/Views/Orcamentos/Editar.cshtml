@model OrcamentoFormulario
@{
    ViewData["Title"] = $"Editar orçamento {Model.Id:D6}";
    ViewData["PageDescription"] = "Revise os dados e os itens antes de salvar as alterações.";
}

<form asp-action="Editar" asp-route-id="@Model.Id" method="post">
    <partial name="_Formulario" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar alterações</button>
        <a asp-action="Detalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
