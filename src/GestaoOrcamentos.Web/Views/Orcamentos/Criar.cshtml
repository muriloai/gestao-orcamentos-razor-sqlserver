@model OrcamentoFormulario
@{
    ViewData["Title"] = "Novo orçamento";
    ViewData["PageDescription"] = "Monte uma proposta com os dados do cliente, itens e condições.";
}

<form asp-action="Criar" method="post">
    <partial name="_Formulario" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Salvar orçamento</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>
</form>
