@model OrcamentosLista
@{
    ViewData["Title"] = "Orçamentos";
    ViewData["PageDescription"] = "Crie propostas, consulte seus valores e acompanhe cada etapa.";
}

@section PageActions {
    <a asp-action="Criar" class="btn btn-primary">Novo orçamento</a>
}

<form asp-action="Index" method="get" class="row g-2 filter-form" role="search">
    <div class="col-sm-8 col-md-6">
        <label for="busca" class="form-label">Pesquisar por cliente ou título</label>
        <input id="busca" name="busca" value="@Model.Busca" class="form-control" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label asp-for="Situacao" class="form-label">Situação</label>
        <select asp-for="Situacao" asp-items="Html.GetEnumSelectList<SituacaoOrcamento>()" class="form-select">
            <option value="">Todas</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-outline-primary">Pesquisar</button>
    </div>
</form>

@if (Model.Orcamentos.Count == 0)
{
    <p class="empty-state">Nenhum orçamento encontrado.</p>
}
else
{
    <div class="table-responsive">
        <table class="table app-table">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Emissão</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Título</th>
                    <th scope="col">Situação</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col">Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orcamento in Model.Orcamentos)
                {
                    <tr>
                        <td>@orcamento.Numero</td>
                        <td>@orcamento.DataEmissao.ToString("dd/MM/yyyy")</td>
                        <td><a asp-controller="Clientes" asp-action="Detalhes" asp-route-id="@orcamento.ClienteId">@orcamento.NomeCliente</a></td>
                        <td>@orcamento.Titulo</td>
                        <td>@orcamento.SituacaoTexto</td>
                        <td class="text-end">@orcamento.Total.ToString("C")</td>
                        <td><a asp-action="Detalhes" asp-route-id="@orcamento.Id">Consultar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
