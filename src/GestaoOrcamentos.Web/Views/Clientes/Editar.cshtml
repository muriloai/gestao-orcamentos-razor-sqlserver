@model ClienteFormulario
@{
    ViewData["Title"] = "Editar cliente";
    ViewData["PageDescription"] = "Atualize as informações usadas no contato e nos próximos orçamentos.";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
            <partial name="_Campos" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Detalhes" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
