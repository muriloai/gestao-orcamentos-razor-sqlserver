@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
    ViewData["PageHeading"] = "Não foi possível concluir a solicitação.";
    ViewData["PageDescription"] = "Tente novamente. Se o problema continuar, informe o identificador abaixo ao responsável pela aplicação.";
}

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador:</strong> <code>@Model.RequestId</code>
    </p>
}
