@model AvisosOrcamentos
@{
    ViewData["Title"] = "Orçamentos vencidos";
    ViewData["PageDescription"] = $"Pendentes de aprovação com validade anterior a {Model.DataReferencia:dd/MM/yyyy}.";
}

@if (Model.Orcamentos.Count == 0)
{
    <p class="empty-state">Nenhum orçamento vencido pendente de aprovação.</p>
}
else
{
    <div class="table-responsive">
        <table class="table app-table">
            <thead>
                <tr>
                    <th scope="col">Número</th>
                    <th scope="col">Cliente</th>
                    <th scope="col">Título</th>
                    <th scope="col">Validade</th>
                    <th scope="col" class="text-end">Total</th>
                    <th scope="col">Ação</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var orcamento in Model.Orcamentos)
                {
                    <tr>
                        <td>@orcamento.Numero</td>
                        <td>@orcamento.NomeCliente</td>
                        <td>@orcamento.Titulo</td>
                        <td>@orcamento.Validade!.Value.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">@orcamento.Total.ToString("C")</td>
                        <td><a asp-controller="Orcamentos" asp-action="Detalhes" asp-route-id="@orcamento.Id">Consultar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
